    "Suffix",
    "Box"
  ],
  "derived_definitions": {
    "Falsity": "Neg Truth",
    "Disj a b": "Neg (Conj (Neg a) (Neg b))",
    "Impl a b": "Neg (Conj a (Neg b))",
    "Coextension x a": "Neg (Extension x (Neg a))",
    "DualSuffix a b": "Neg (Suffix (Neg a) (Neg b))",
    "Diamond p a": "Neg (Box p (Neg a))"
  },
